{
  "version": "1",
  "media_path": "/public",
  "ssg_framework": "astro",
  "frontmatter_format": "yaml",
  "sitemap_url": "https://opencode.ai/sitemap.xml",
  "publishing_mode": "editorial_workflow",
  "i18n": {
    "enabled": true,
    "locales": [
      "en",
      "ar",
      "bs",
      "da",
      "de",
      "es",
      "fr",
      "hi",
      "it",
      "ja",
      "ko",
      "nb",
      "pl",
      "pt-br",
      "ru",
      "th",
      "tr",
      "zh-cn",
      "zh-tw"
    ],
    "default_locale": "en",
    "prefix_default_locale": false
  },
  "collections": [
    {
      "name": "docs",
      "git_path": "/src/content/docs/",
      "file_extension": ".mdx",
      "filename_pattern": "",
      "collection_type": "grouped",
      "i18n": {
        "enabled": true,
        "strategy": "path"
      },
      "frontmatter_schema": [
        {
          "name": "title",
          "type": "title",
          "label": "Title"
        },
        {
          "name": "description",
          "type": "richtext",
          "label": "Description"
        }
      ]
    }
  ]
}
